#!/bin/sh /etc/rc.common

START=96
USE_PROCD=1

OVERLAY_BASE=/overlay/openvpn-ubus-setup
DAEMON_BIN=/usr/sbin/openvpn-ubusd
ALT_BIN=/usr/local/usr/sbin/openvpn-ubusd

setup_daemon_overlay() {
    [ -x "$DAEMON_BIN" ] && return 0
    [ -x "$ALT_BIN" ] || return 1

    grep -q ' /usr/sbin overlay' /proc/mounts && return 0

    mkdir -p "$OVERLAY_BASE/sbin-upper" "$OVERLAY_BASE/sbin-work"
    cp -a "$ALT_BIN" "$OVERLAY_BASE/sbin-upper/openvpn-ubusd"
    mount -t overlay overlay \
        -o lowerdir=/usr/sbin,upperdir="$OVERLAY_BASE/sbin-upper",workdir="$OVERLAY_BASE/sbin-work" \
        /usr/sbin
}

start_service() {
    setup_daemon_overlay

    local bin="$DAEMON_BIN"
    [ -x "$bin" ] || bin="$ALT_BIN"
    [ -x "$bin" ] || return 1

    procd_open_instance
    procd_set_param command "$bin"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "openvpn"
}
